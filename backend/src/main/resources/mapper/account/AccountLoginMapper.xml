<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.surimap.account.repository.AccountLoginMapper">

    <resultMap id="AccountLoginRowMap" type="com.surimap.account.repository.AccountLoginRow">
        <constructor>
            <arg column="id" javaType="java.util.UUID" typeHandler="com.surimap.config.mybatis.UuidTypeHandler"/>
            <arg column="login_id" javaType="java.lang.String"/>
            <arg column="password_hash" javaType="java.lang.String"/>
            <arg column="account_type" javaType="com.surimap.common.auth.AccountType"/>
            <arg column="organization_type" javaType="com.surimap.common.auth.OrganizationType"/>
        </constructor>
    </resultMap>

    <select id="findActiveAccountByLoginId" resultMap="AccountLoginRowMap">
        SELECT id, login_id, password_hash, account_type, organization_type
        FROM account
        WHERE login_id = #{loginId}
          AND status = 'ACTIVE'
    </select>

</mapper>
