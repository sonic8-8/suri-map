#!/bin/sh
# 새로 추가하거나 고친 문서 줄을 검사해 커밋을 막는다. 기존 줄은 검사하지 않는다.
added=$(git -c core.quotePath=false diff --cached -U0 --diff-filter=ACMR -- '*.md' | awk '
  /^\+\+\+ b\// { file = substr($0, 7); sub(/\t$/, "", file) }
  /^@@/ { split($3, a, ","); line = substr(a[1], 2) - 1 }
  /^\+/ && !/^\+\+\+/ { line++; print file ":" line ": " substr($0, 2) }
')
failed=0

dots=$(printf '%s\n' "$added" | grep -F '·')
if [ -n "$dots" ]; then
  echo "가운뎃점(·)을 쉼표, 와/과, 및으로 바꿔 주세요." >&2
  echo "$dots" >&2
  failed=1
fi

# .scratch는 Git에 올리지 않는 작업대라, 저장소 문서에서 링크하면 다른 사람에게는 깨진 링크가 된다.
links=$(printf '%s\n' "$added" | grep -E '\]\([^)]*\.scratch/')
if [ -n "$links" ]; then
  echo ".scratch 링크를 지우고, 남길 내용은 저장소 문서에 직접 써 주세요." >&2
  echo "$links" >&2
  failed=1
fi

exit $failed
