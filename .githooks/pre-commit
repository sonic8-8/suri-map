#!/bin/sh
# 새로 추가하거나 고친 줄을 검사해 커밋을 막는다. 기존 줄은 검사하지 않는다.
all=$(git -c core.quotePath=false diff --cached -U0 --diff-filter=ACMR | awk '
  /^\+\+\+ b\// { file = substr($0, 7); sub(/\t$/, "", file) }
  /^@@/ { split($3, a, ","); line = substr(a[1], 2) - 1 }
  /^\+/ && !/^\+\+\+/ { line++; print file ":" line ": " substr($0, 2) }
')
added=$(printf '%s\n' "$all" | grep -E '^[^:]*\.md:[0-9]+: ')
failed=0

# 코드는 주석 부분만 본다. 화면 문구는 가운뎃점을 구분자로 쓰기 때문이다.
code_dots=$(printf '%s\n' "$all" | grep -v -E '^[^:]*\.md:[0-9]+: ' | awk '{
  text = $0; sub(/^[^:]*:[0-9]+: /, "", text)
  if (match(text, /^[ \t]*(\/\/|\/\*|\*|#|--|<!--)/)) start = 1
  else if (match(text, /[ \t](\/\/|\/\*|#|<!--)|[ \t]--[ \t]/)) start = RSTART
  else next
  if (index(substr(text, start), "·")) print
}')

dots=$(printf '%s\n' "$added" | grep -F '·'; [ -z "$code_dots" ] || printf '%s\n' "$code_dots")
if [ -n "$dots" ]; then
  echo "가운뎃점(·)을 쉼표, 와/과, 및으로 바꿔 주세요." >&2
  echo "$dots" >&2
  failed=1
fi

# .scratch는 Git에 올리지 않는 작업대라, 저장소 문서에서 링크하면 다른 사람에게는 깨진 링크가 된다.
links=$(printf '%s\n' "$added" | grep -E '\]\([^)]*\.scratch/')
if [ -n "$links" ]; then
  echo ".scratch 링크를 지우고, 남길 내용은 저장소 문서에 직접 써 주세요." >&2
  echo "$links" >&2
  failed=1
fi

exit $failed
