KEYCLOAK_ADMIN=${env.KEYCLOAK_ADMIN}
KEYCLOAK_ADMIN_PASSWORD=${env.KEYCLOAK_ADMIN_PASSWORD}
KEYCLOAK_IMPORT_DIR=${env.KEYCLOAK_IMPORT_DIR}
KEYCLOAK_THEME_DIR=${env.KEYCLOAK_THEME_DIR}
SURI_MAP_KEYCLOAK_ISSUER_URI=${env.SURI_MAP_KEYCLOAK_ISSUER_URI}
SURI_MAP_KEYCLOAK_JWK_SET_URI=${env.SURI_MAP_KEYCLOAK_JWK_SET_URI}
OBJECT_STORAGE_HOST_PORT=${env.OBJECT_STORAGE_HOST_PORT}
OBJECT_STORAGE_CONSOLE_HOST_PORT=${env.OBJECT_STORAGE_CONSOLE_HOST_PORT}
SURI_MAP_OBJECT_STORAGE_PROVIDER=${env.SURI_MAP_OBJECT_STORAGE_PROVIDER}
SURI_MAP_OBJECT_STORAGE_ENDPOINT=${env.SURI_MAP_OBJECT_STORAGE_ENDPOINT}
SURI_MAP_OBJECT_STORAGE_PUBLIC_ENDPOINT=${env.SURI_MAP_OBJECT_STORAGE_PUBLIC_ENDPOINT}
SURI_MAP_OBJECT_STORAGE_BUCKET=${env.SURI_MAP_OBJECT_STORAGE_BUCKET}
SURI_MAP_OBJECT_STORAGE_ACCESS_KEY=${env.SURI_MAP_OBJECT_STORAGE_ACCESS_KEY}
SURI_MAP_OBJECT_STORAGE_SECRET_KEY=${env.SURI_MAP_OBJECT_STORAGE_SECRET_KEY}
SURI_MAP_OBJECT_STORAGE_REGION=${env.SURI_MAP_OBJECT_STORAGE_REGION}
MOCK_112_ENABLED=${env.MOCK_112_ENABLED}
MOCK_112_BASE_URL=${env.MOCK_112_BASE_URL}
MOCK_112_POLLING_INTERVAL=${env.MOCK_112_POLLING_INTERVAL}
SURI_MAP_WEBHOOK_ENABLED=${env.SURI_MAP_WEBHOOK_ENABLED}
SURI_MAP_WEBHOOK_URL=${env.SURI_MAP_WEBHOOK_URL}
MOCK112_WEBHOOK_SECRET=${env.MOCK112_WEBHOOK_SECRET}
MOCK112_INTERNAL_API_TOKEN=${env.MOCK112_INTERNAL_API_TOKEN}
TILESERVER_HOST_PORT=${env.TILESERVER_HOST_PORT}
TILESERVER_DATA_DIR=${env.TILESERVER_DATA_DIR}
TILESERVER_MODE=${env.TILESERVER_MODE}
TILESERVER_BASE_URL=${env.TILESERVER_BASE_URL}
SURI_MAP_OPENAI_ENABLED=${env.SURI_MAP_OPENAI_ENABLED}
SURI_MAP_OPENAI_BASE_URL=${env.SURI_MAP_OPENAI_BASE_URL}
SURI_MAP_OPENAI_API_KEY=${env.SURI_MAP_OPENAI_API_KEY}
SURI_MAP_OPENAI_MODEL=${env.SURI_MAP_OPENAI_MODEL}
SURI_MAP_OPENAI_TIMEOUT_MS=${env.SURI_MAP_OPENAI_TIMEOUT_MS}
FCM_PROVIDER=${env.FCM_PROVIDER}
FIREBASE_CREDENTIALS_LOCATION=${env.FIREBASE_CREDENTIALS_LOCATION}
FIREBASE_CREDENTIALS_JSON_BASE64=${env.FIREBASE_CREDENTIALS_JSON_BASE64}
FIREBASE_PROJECT_ID=${env.FIREBASE_PROJECT_ID}
FIREBASE_FCM_DRY_RUN=${env.FIREBASE_FCM_DRY_RUN}
POSTGRES_HOST_PORT=${env.POSTGRES_HOST_PORT}
POSTGRES_DB=${env.POSTGRES_DB}
POSTGRES_USER=${env.POSTGRES_USER}
POSTGRES_PASSWORD=${env.POSTGRES_PASSWORD}
SPRING_JPA_HIBERNATE_DDL_AUTO=${env.SPRING_JPA_HIBERNATE_DDL_AUTO}
""".trim() + "\n"

                sh '''
                    mkdir -p \
                      "${TILESERVER_DATA_DIR}/data" \
                      "${TILESERVER_DATA_DIR}/fonts" \
                      "${TILESERVER_DATA_DIR}/styles/osm-local" \
                      "${KEYCLOAK_IMPORT_DIR}" \
                      "${KEYCLOAK_THEME_DIR}" \
                      "${HOST_NGINX_CONFIG_DIR}"
                    cp infra/docker/tileserver/config.json "${TILESERVER_DATA_DIR}/config.json"
                    cp infra/docker/tileserver/styles/osm-local/style.json "${TILESERVER_DATA_DIR}/styles/osm-local/style.json"
                    cp infra/docker/keycloak/import/*.json "${KEYCLOAK_IMPORT_DIR}/"
                    rm -rf "${KEYCLOAK_THEME_DIR}/suri-map"
                    cp -R infra/docker/keycloak/themes/suri-map "${KEYCLOAK_THEME_DIR}/suri-map"
                    cp infra/nginx/suri-map-sse.locations.conf "${HOST_NGINX_CONFIG_DIR}/suri-map-sse.locations.conf"
                    cp infra/nginx/apply-suri-map-host-nginx.sh "${HOST_NGINX_CONFIG_DIR}/apply-suri-map-host-nginx.sh"
                    chmod 755 "${HOST_NGINX_CONFIG_DIR}/apply-suri-map-host-nginx.sh"
                    test -f "${KEYCLOAK_IMPORT_DIR}/suri-map-realm.json"
                    test -f "${KEYCLOAK_THEME_DIR}/suri-map/login/theme.properties"
                    test -f "${HOST_NGINX_CONFIG_DIR}/suri-map-sse.locations.conf"

                    if [ -f "${TILESERVER_DATA_DIR}/data/osm-local.mbtiles" ] \
                      && [ -f "${TILESERVER_DATA_DIR}/data/gwangju-building-labels.mbtiles" ]; then
                      bash infra/docker/tileserver/scripts/build-pretendard-gov-glyphs.sh \
                        android/app/src/main/res/font/pretendard_gov_variable.ttf \
                        "${TILESERVER_DATA_DIR}/fonts/Pretendard GOV"
                      COMPOSE_SERVICES="postgis mock-112 keycloak object-storage backend tileserver-gl frontend"
                    else
                      echo "tileserver_mbtiles=missing required=osm-local.mbtiles,gwangju-building-labels.mbtiles dir=${TILESERVER_DATA_DIR}/data"
                      echo "tileserver-gl deployment skipped until the environment-specific MBTiles files are placed."
                      COMPOSE_SERVICES="postgis mock-112 keycloak object-storage backend frontend"
                    fi

                    docker compose \
                      --env-file ${ENV_FILE} \
                      -f ${COMPOSE_FILE} \
                      up -d ${COMPOSE_SERVICES}

                    if printf '%s\n' "${COMPOSE_SERVICES}" | grep -q 'tileserver-gl'; then
                      docker compose \
                        --env-file ${ENV_FILE} \
                        -f ${COMPOSE_FILE} \
                        up -d --force-recreate tileserver-gl
                    fi

                    if [ "${HOST_NGINX_APPLY}" = "true" ]; then
                      docker run --rm \
                        --privileged \
                        --pid=host \
                        -v /:/host \
                        -e HOST_ROOT=/host \
                        -e HOST_NGINX_SITE="${HOST_NGINX_SITE}" \
                        -e HOST_NGINX_SSE_SNIPPET="${HOST_NGINX_CONFIG_DIR}/suri-map-sse.locations.conf" \
                        alpine:3.20 \
                        sh "/host${HOST_NGINX_CONFIG_DIR}/apply-suri-map-host-nginx.sh"
                    else
                      echo "host_nginx_sse_proxy=skipped"
                    fi
                '''
            }
        }

        stage('Verify Runtime') {
            steps {
                script {
                    env.FAILED_STAGE = 'Verify Runtime Startup'
                }

                sh '''
                    frontend_ready=false
                    for i in $(seq 1 30); do
                      if docker exec suri-map-frontend wget -qO- http://127.0.0.1/ >/dev/null; then
                        echo "frontend_health=ready"
                        frontend_ready=true
                        break
                      fi
                      sleep 2
                    done

                    if [ "${frontend_ready}" != "true" ]; then
                      echo "frontend_health=timeout"
                      docker logs --tail=200 suri-map-frontend || true
                      exit 1
                    fi

                    mock112_ready=false
                    for i in $(seq 1 30); do
                      if docker exec suri-map-mock-112 wget -qO- http://127.0.0.1:18112/mock-112/health >/dev/null; then
                        echo "mock112_health=ready"
                        mock112_ready=true
                        break
                      fi
                      sleep 2
                    done

                    if [ "${mock112_ready}" != "true" ]; then
                      echo "mock112_health=timeout"
                      docker logs --tail=200 suri-map-mock-112 || true
                      exit 1
                    fi

                    keycloak_ready=false
                    for i in $(seq 1 60); do
                      if docker exec suri-map-frontend wget -qO- http://keycloak:9000/keycloak/health/ready >/dev/null; then
                        echo "keycloak_health=ready"
                        keycloak_ready=true
                        break
                      fi
                      sleep 2
                    done

                    if [ "${keycloak_ready}" != "true" ]; then
                      echo "keycloak_health=timeout"
                      docker logs --tail=200 suri-map-keycloak || true
                      exit 1
                    fi

                    docker exec \
                      -e KEYCLOAK_ADMIN="${KEYCLOAK_ADMIN}" \
                      -e KEYCLOAK_ADMIN_PASSWORD="${KEYCLOAK_ADMIN_PASSWORD}" \
                      suri-map-keycloak \
                      sh -ec '
                        server_url="http://127.0.0.1:8080/keycloak"
                        if /opt/keycloak/bin/kcadm.sh config credentials \
                          --server "${server_url}" \
                          --realm master \
                          --user "${KEYCLOAK_ADMIN}" \
                          --password "${KEYCLOAK_ADMIN_PASSWORD}" >/dev/null 2>&1; then
                          echo "keycloak_admin_password=current"
                          exit 0
                        fi

                        /opt/keycloak/bin/kcadm.sh config credentials \
                          --server "${server_url}" \
                          --realm master \
                          --user "${KEYCLOAK_ADMIN}" \
                          --password admin >/dev/null
                        admin_id=$(/opt/keycloak/bin/kcadm.sh get users \
                          -r master \
                          -q username="${KEYCLOAK_ADMIN}" \
                          --fields id \
                          --format csv \
                          --noquotes | tail -n 1)
                        test -n "${admin_id}"
                        /opt/keycloak/bin/kcadm.sh set-password \
                          -r master \
                          --userid "${admin_id}" \
                          --new-password "${KEYCLOAK_ADMIN_PASSWORD}" >/dev/null
                        /opt/keycloak/bin/kcadm.sh config credentials \
                          --server "${server_url}" \
                          --realm master \
                          --user "${KEYCLOAK_ADMIN}" \
                          --password "${KEYCLOAK_ADMIN_PASSWORD}" >/dev/null
                        echo "keycloak_admin_password=rotated"
                      '

                    docker exec \
                      -e KEYCLOAK_ADMIN="${KEYCLOAK_ADMIN}" \
                      -e KEYCLOAK_ADMIN_PASSWORD="${KEYCLOAK_ADMIN_PASSWORD}" \
                      suri-map-keycloak \
                      sh -ec '
                        server_url="http://127.0.0.1:8080/keycloak"
                        /opt/keycloak/bin/kcadm.sh config credentials \
                          --server "${server_url}" \
                          --realm master \
                          --user "${KEYCLOAK_ADMIN}" \
                          --password "${KEYCLOAK_ADMIN_PASSWORD}" >/dev/null

