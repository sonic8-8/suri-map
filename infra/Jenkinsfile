KEYCLOAK_MANAGEMENT_HOST_PORT=${env.KEYCLOAK_MANAGEMENT_HOST_PORT}
KEYCLOAK_POSTGRES_HOST_PORT=${env.KEYCLOAK_POSTGRES_HOST_PORT}
KEYCLOAK_POSTGRES_DB=${env.KEYCLOAK_POSTGRES_DB}
KEYCLOAK_POSTGRES_USER=${env.KEYCLOAK_POSTGRES_USER}
