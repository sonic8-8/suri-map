                        ensure_mapper() {
                          client_id="$1"
                          attr="$2"
                          client_uuid=$(/opt/keycloak/bin/kcadm.sh get clients \
                            -r suri-map \
                            -q clientId="${client_id}" \
                            --fields id \
                            --format csv \
                            --noquotes | tail -n 1)
                          test -n "${client_uuid}"
                          if /opt/keycloak/bin/kcadm.sh get \
                            "clients/${client_uuid}/protocol-mappers/models" \
                            -r suri-map \
                            --fields name \
                            --format csv \
                            --noquotes | grep -Fxq "${attr}"; then
                            return 0
                          fi
                          cat >"/tmp/${client_id}-${attr}-mapper.json" <<EOF
{
  "name": "${attr}",
  "protocol": "openid-connect",
  "protocolMapper": "oidc-usermodel-attribute-mapper",
  "consentRequired": false,
  "config": {
    "user.attribute": "${attr}",
    "claim.name": "${attr}",
    "jsonType.label": "String",
    "id.token.claim": "true",
    "access.token.claim": "true",
    "userinfo.token.claim": "true",
    "multivalued": "false"
  }
}
EOF
                          /opt/keycloak/bin/kcadm.sh create \
                            "clients/${client_uuid}/protocol-mappers/models" \
                            -r suri-map \
                            -f "/tmp/${client_id}-${attr}-mapper.json" >/dev/null
                        }

                        for client in suri-map-web suri-map-android suri-map-mock112; do
                          for attr in accountId accountCode personName displayName accountType organizationType organizationCode organizationName rankCode rankName; do
                            ensure_mapper "${client}" "${attr}"
                          done
                        done
                        echo "keycloak_suri_map_claim_mappers=ready"

                        /opt/keycloak/bin/kcadm.sh update realms/suri-map \
                          -s "loginTheme=suri-map" \
                          -s "accessTokenLifespan=7200" \
                          -s "ssoSessionIdleTimeout=28800" \
                          -s "ssoSessionMaxLifespan=43200" \
                          -s "clientSessionIdleTimeout=28800" \
                          -s "clientSessionMaxLifespan=43200" >/dev/null
                        echo "keycloak_suri_map_login_theme=suri-map"
                        echo "keycloak_suri_map_session_policy=ready"

