import groovy.json.JsonOutput

def notifyMattermost(String status) {
    if (!env.GITHUB_DISPATCH_REPOSITORY?.trim()) {
        echo "Mattermost notification skipped: GITHUB_DISPATCH_REPOSITORY is not configured."
        return
    }

    try {
        def commitMessage = sh(script: 'git log -1 --pretty=%s', returnStdout: true).trim()

        def payload = JsonOutput.toJson([
            event_type: env.GITHUB_DISPATCH_EVENT_TYPE,
            client_payload: [
                status: status,
                job_name: env.JOB_NAME,
                build_number: env.BUILD_NUMBER,
                build_url: env.BUILD_URL,
                git_branch: env.GIT_BRANCH ?: '',
                git_commit: env.GIT_COMMIT ?: '',
                commit_message: commitMessage,
                failed_stage: env.FAILED_STAGE ?: ''
            ]
        ])

        writeFile file: '.github-dispatch-payload.json', text: payload + '\n'

        withCredentials([string(credentialsId: 'suri-map-github-dispatch-token', variable: 'GITHUB_DISPATCH_TOKEN')]) {
            sh '''
                curl -fsS -X POST \
                  -H "Authorization: Bearer ${GITHUB_DISPATCH_TOKEN}" \
                  -H "Accept: application/vnd.github+json" \
                  -H "Content-Type: application/json" \
                  -H "X-GitHub-Api-Version: 2022-11-28" \
                  "https://api.github.com/repos/${GITHUB_DISPATCH_REPOSITORY}/dispatches" \
                  --data @.github-dispatch-payload.json
            '''
        }
    } catch (Exception e) {
        echo "Mattermost notification failed: ${e.message}"
    }
}

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        FRONTEND_IMAGE = 'suri-map-frontend:develop'
        BACKEND_IMAGE = 'suri-map-backend:develop'
        MOCK_112_IMAGE = 'suri-map-mock-112:develop'
        BACKEND_TEST_IMAGE = 'suri-map-backend-test:develop'
        BACKEND_TEST_ARTIFACT_DIR = 'ci-artifacts/backend-test'
        COMPOSE_FILE = 'infra/docker/docker-compose.runtime.yml'
        ENV_FILE = '.env.runtime'
        FRONTEND_HOST_PORT = '3000'
        BACKEND_HOST_PORT = '8081'
        MOCK_112_HOST_PORT = '18112'
        MOCK_112_ENABLED = 'true'
        MOCK_112_BASE_URL = 'http://mock-112:18112'
        MOCK_112_POLLING_INTERVAL = '5000'
        SURI_MAP_WEBHOOK_ENABLED = 'true'
        SURI_MAP_WEBHOOK_URL = 'http://backend:8080/api/internal/mock-112/events'
        MOCK_112_WEBHOOK_SECRET = ''
        TILESERVER_HOST_PORT = '8082'
        TILESERVER_DATA_DIR = '/home/ubuntu/infra/tileserver'
        TILESERVER_MODE = 'tileserver-gl'
        TILESERVER_BASE_URL = 'http://tileserver-gl:8080'
        FCM_PROVIDER = 'firebase'
        FIREBASE_CREDENTIALS_LOCATION = ''
        FIREBASE_CREDENTIALS_JSON_BASE64 = credentials('suri-map-firebase-service-account-base64')
        FIREBASE_PROJECT_ID = 'suri-map-174b9'
        FIREBASE_FCM_DRY_RUN = 'false'
        POSTGRES_HOST_PORT = '5432'
        POSTGRES_DB = 'suri_map'
        POSTGRES_USER = 'suri_map_user'
        POSTGRES_PASSWORD = credentials('suri-map-postgres-password')
        SPRING_JPA_HIBERNATE_DDL_AUTO = 'update'
        GITHUB_DISPATCH_REPOSITORY = 'Choi-jinseo/mattermost-reminder-bot'
        GITHUB_DISPATCH_EVENT_TYPE = 'suri_map_ci'
        K6_SMOKE_ARTIFACT_DIR = 'ci-artifacts/k6-smoke'
        S4_EVIDENCE_ARTIFACT_DIR = 'ci-artifacts/s4-evidence'
        BACKEND_TEST_RESULT_DIR = 'backend/build/test-results/test'
    }

    stages {
        stage('Checkout Info') {
            steps {
                script {
                    env.FAILED_STAGE = 'Checkout Info'
                }

                sh 'git branch --show-current || true'
                sh 'git rev-parse --short HEAD || true'
                sh 'git log -1 --pretty=%s || true'
            }
        }

        stage('Backend Test CI') {
            steps {
                script {
                    env.FAILED_STAGE = 'Backend Test CI'
                }

                sh '''
                    rm -rf "${BACKEND_TEST_ARTIFACT_DIR}"
                    mkdir -p \
                      "${BACKEND_TEST_ARTIFACT_DIR}/coverage" \
                      "${BACKEND_TEST_ARTIFACT_DIR}/sonar"
                '''

                sh '''
                    rm -rf \
                      backend/build/reports/tests/test \
                      backend/build/test-results/test

                    docker build \
                      --target tester \
                      -t ${BACKEND_TEST_IMAGE} \
                      -f backend/Dockerfile \
                      .

                    test_container=$(docker create ${BACKEND_TEST_IMAGE})
                    trap 'docker rm -f "${test_container}" >/dev/null 2>&1 || true' EXIT

                    mkdir -p \
                      backend/build/reports/tests \
                      backend/build/test-results

                    docker cp "${test_container}:/workspace/build/reports/tests/test" \
                      backend/build/reports/tests/
                    docker cp "${test_container}:/workspace/build/test-results/test" \
                      backend/build/test-results/

                    docker cp "${test_container}:/workspace/build/reports/jacoco/test/jacocoTestReport.xml" \
                      "${BACKEND_TEST_ARTIFACT_DIR}/coverage/jacoco.xml" 2>/dev/null || true

                    docker cp "${test_container}:/workspace/build/reports/jacoco/test/html" \
                      "${BACKEND_TEST_ARTIFACT_DIR}/coverage/html" 2>/dev/null || true
                '''

                sh '''
                    if [ -f "${BACKEND_TEST_ARTIFACT_DIR}/coverage/jacoco.xml" ]; then
                        missed=$(grep -oE 'type="LINE"[^>]* missed="[0-9]+"' "${BACKEND_TEST_ARTIFACT_DIR}/coverage/jacoco.xml" \
                                 | tail -1 | grep -oE 'missed="[0-9]+"' | grep -oE '[0-9]+' || echo "0")
                        covered=$(grep -oE 'type="LINE"[^>]* covered="[0-9]+"' "${BACKEND_TEST_ARTIFACT_DIR}/coverage/jacoco.xml" \
                                  | tail -1 | grep -oE 'covered="[0-9]+"' | grep -oE '[0-9]+' || echo "0")
                        total=$((missed + covered))
                        if [ "${total}" -gt 0 ]; then
                            pct_tenths=$(((covered * 1000 + total / 2) / total))
                            pct="$((pct_tenths / 10)).$((pct_tenths % 10))"
                        else
                            pct="0.0"
                        fi
                        echo "COVERAGE: ${pct}%" > "${BACKEND_TEST_ARTIFACT_DIR}/coverage/coverage-summary.txt"
                        echo "LINE_COVERED: ${covered}" >> "${BACKEND_TEST_ARTIFACT_DIR}/coverage/coverage-summary.txt"
                        echo "LINE_MISSED: ${missed}" >> "${BACKEND_TEST_ARTIFACT_DIR}/coverage/coverage-summary.txt"
                        echo "LINE_TOTAL: ${total}" >> "${BACKEND_TEST_ARTIFACT_DIR}/coverage/coverage-summary.txt"
                    fi
                '''

                sh '''
                    echo "STATUS: SKIPPED_NO_SERVER" > "${BACKEND_TEST_ARTIFACT_DIR}/sonar/sonar-status.txt"
                    echo "REASON: SonarQube server not yet configured for this environment" >> "${BACKEND_TEST_ARTIFACT_DIR}/sonar/sonar-status.txt"
                '''
            }

            post {
                always {
                    junit allowEmptyResults: true, testResults: 'backend/build/test-results/test/**/*.xml'
                    archiveArtifacts(
                        allowEmptyArchive: true,
                        artifacts: 'ci-artifacts/backend-test/**,backend/build/reports/tests/test/**,backend/build/test-results/test/**/*.xml',
                        fingerprint: true
                    )
                }
            }
        }

        stage('S4 Evidence') {
            steps {
                script {
                    env.FAILED_STAGE = 'S4 Evidence'
                }
                sh 'sh infra/ci/collect-s4-evidence.sh'
                sh 'sh infra/ci/verify-s4-evidence.sh'
            }
            post {
                always {
                    archiveArtifacts(
                        allowEmptyArchive: true,
                        artifacts: 'ci-artifacts/s4-evidence/**',
                        fingerprint: true
                    )
                }
            }
        }

        stage('Build Runtime Images') {
            parallel {
                stage('Frontend Image') {
                    steps {
                        script {
                            env.FAILED_STAGE = 'Build Runtime Images'
                        }

                        sh '''
                            docker build \
                              -t ${FRONTEND_IMAGE} \
                              -f frontend/Dockerfile \
                              frontend
                        '''
                    }
                }

                stage('Backend Image') {
                    steps {
                        script {
                            env.FAILED_STAGE = 'Build Runtime Images'
                        }

                        sh '''
                            docker build \
                              -t ${BACKEND_IMAGE} \
                              -f backend/Dockerfile \
                              .
                        '''
                    }
                }

                stage('Mock 112 Image') {
                    steps {
                        script {
                            env.FAILED_STAGE = 'Build Runtime Images'
                        }

                        sh '''
                            docker build \
                              -t ${MOCK_112_IMAGE} \
                              -f mock-112/Dockerfile \
                              mock-112
                        '''
                    }
                }
            }
        }

        stage('Deploy Runtime') {
            steps {
                script {
                    env.FAILED_STAGE = 'Deploy Runtime'
                }

                writeFile file: env.ENV_FILE, text: """
FRONTEND_IMAGE=${env.FRONTEND_IMAGE}
BACKEND_IMAGE=${env.BACKEND_IMAGE}
MOCK_112_IMAGE=${env.MOCK_112_IMAGE}
FRONTEND_HOST_PORT=${env.FRONTEND_HOST_PORT}
BACKEND_HOST_PORT=${env.BACKEND_HOST_PORT}
MOCK_112_HOST_PORT=${env.MOCK_112_HOST_PORT}
MOCK_112_ENABLED=${env.MOCK_112_ENABLED}
MOCK_112_BASE_URL=${env.MOCK_112_BASE_URL}
MOCK_112_POLLING_INTERVAL=${env.MOCK_112_POLLING_INTERVAL}
SURI_MAP_WEBHOOK_ENABLED=${env.SURI_MAP_WEBHOOK_ENABLED}
SURI_MAP_WEBHOOK_URL=${env.SURI_MAP_WEBHOOK_URL}
MOCK_112_WEBHOOK_SECRET=${env.MOCK_112_WEBHOOK_SECRET}
TILESERVER_HOST_PORT=${env.TILESERVER_HOST_PORT}
TILESERVER_DATA_DIR=${env.TILESERVER_DATA_DIR}
TILESERVER_MODE=${env.TILESERVER_MODE}
TILESERVER_BASE_URL=${env.TILESERVER_BASE_URL}
FCM_PROVIDER=${env.FCM_PROVIDER}
FIREBASE_CREDENTIALS_LOCATION=${env.FIREBASE_CREDENTIALS_LOCATION}
FIREBASE_CREDENTIALS_JSON_BASE64=${env.FIREBASE_CREDENTIALS_JSON_BASE64}
FIREBASE_PROJECT_ID=${env.FIREBASE_PROJECT_ID}
FIREBASE_FCM_DRY_RUN=${env.FIREBASE_FCM_DRY_RUN}
POSTGRES_HOST_PORT=${env.POSTGRES_HOST_PORT}
POSTGRES_DB=${env.POSTGRES_DB}
POSTGRES_USER=${env.POSTGRES_USER}
POSTGRES_PASSWORD=${env.POSTGRES_PASSWORD}
SPRING_JPA_HIBERNATE_DDL_AUTO=${env.SPRING_JPA_HIBERNATE_DDL_AUTO}
""".trim() + "\n"

                sh '''
                    mkdir -p \
                      "${TILESERVER_DATA_DIR}/data" \
                      "${TILESERVER_DATA_DIR}/fonts" \
                      "${TILESERVER_DATA_DIR}/styles/osm-local"
                    cp infra/docker/tileserver/config.json "${TILESERVER_DATA_DIR}/config.json"
                    cp infra/docker/tileserver/styles/osm-local/style.json "${TILESERVER_DATA_DIR}/styles/osm-local/style.json"

                    if [ -f "${TILESERVER_DATA_DIR}/data/osm-local.mbtiles" ] \
                      && [ -f "${TILESERVER_DATA_DIR}/data/gwangju-building-labels.mbtiles" ]; then
                      bash infra/docker/tileserver/scripts/build-pretendard-gov-glyphs.sh \
                        android/app/src/main/res/font/pretendard_gov_variable.ttf \
                        "${TILESERVER_DATA_DIR}/fonts/Pretendard GOV"
                      COMPOSE_SERVICES="postgis mock-112 backend tileserver-gl frontend"
                    else
                      echo "tileserver_mbtiles=missing required=osm-local.mbtiles,gwangju-building-labels.mbtiles dir=${TILESERVER_DATA_DIR}/data"
                      echo "tileserver-gl deployment skipped until the environment-specific MBTiles files are placed."
                      COMPOSE_SERVICES="postgis mock-112 backend frontend"
                    fi

                    docker compose \
                      --env-file ${ENV_FILE} \
                      -f ${COMPOSE_FILE} \
                      up -d ${COMPOSE_SERVICES}

                    if printf '%s\n' "${COMPOSE_SERVICES}" | grep -q 'tileserver-gl'; then
                      docker compose \
                        --env-file ${ENV_FILE} \
                        -f ${COMPOSE_FILE} \
                        up -d --force-recreate tileserver-gl
                    fi
                '''
            }
        }

        stage('Verify Runtime') {
            steps {
                script {
                    env.FAILED_STAGE = 'Verify Runtime Startup'
                }

                sh '''
                    frontend_ready=false
                    for i in $(seq 1 30); do
                      if docker exec suri-map-frontend wget -qO- http://127.0.0.1/ >/dev/null; then
                        echo "frontend_health=ready"
                        frontend_ready=true
                        break
                      fi
                      sleep 2
                    done

                    if [ "${frontend_ready}" != "true" ]; then
                      echo "frontend_health=timeout"
                      docker logs --tail=200 suri-map-frontend || true
                      exit 1
                    fi

                    mock112_ready=false
                    for i in $(seq 1 30); do
                      if docker exec suri-map-mock-112 wget -qO- http://127.0.0.1:18112/mock-112/health >/dev/null; then
                        echo "mock112_health=ready"
                        mock112_ready=true
                        break
                      fi
                      sleep 2
                    done

                    if [ "${mock112_ready}" != "true" ]; then
                      echo "mock112_health=timeout"
                      docker logs --tail=200 suri-map-mock-112 || true
                      exit 1
                    fi

                    backend_ready=false
                    for i in $(seq 1 60); do
                      if docker exec suri-map-frontend wget -qO- http://backend:8080/api/health >/dev/null; then
                        echo "backend_health=ready"
                        backend_ready=true
                        break
                      fi
                      sleep 2
                    done

                    if [ "${backend_ready}" != "true" ]; then
                      echo "backend_health=timeout"
                      docker logs --tail=200 suri-map-backend || true
                      exit 1
                    fi

                    if [ -f "${TILESERVER_DATA_DIR}/data/osm-local.mbtiles" ] \
                      && [ -f "${TILESERVER_DATA_DIR}/data/gwangju-building-labels.mbtiles" ]; then
                      tileserver_ready=false
                      for i in $(seq 1 30); do
                        if docker exec suri-map-tileserver-gl node -e "require('http').get('http://127.0.0.1:8080/styles/osm-local/style.json', r => process.exit(r.statusCode >= 200 && r.statusCode < 400 ? 0 : 1)).on('error', () => process.exit(1))"; then
                          echo "tileserver_health=ready"
                          tileserver_ready=true
                          break
                        fi
                        sleep 2
                      done

                      if [ "${tileserver_ready}" != "true" ]; then
                        echo "tileserver_health=timeout"
                        docker logs --tail=200 suri-map-tileserver-gl || true
                        exit 1
                      fi

                      if docker exec suri-map-tileserver-gl node -e "require('http').get('http://127.0.0.1:8080/fonts/Pretendard%20GOV/0-255.pbf', r => process.exit(r.statusCode >= 200 && r.statusCode < 400 ? 0 : 1)).on('error', () => process.exit(1))"; then
                        echo "tileserver_glyphs=ready"
                      else
                        echo "tileserver_glyphs=missing font_stack=Pretendard GOV range=0-255.pbf"
                        docker logs --tail=200 suri-map-tileserver-gl || true
                        exit 1
                      fi
                    else
                      echo "tileserver_health=skipped reason=missing_required_mbtiles"
                    fi
                '''
            }
        }

        stage('k6 Smoke') {
            when {
                expression {
                    return (env.K6_SMOKE_ENABLED ?: 'false').trim().equalsIgnoreCase('true')
                }
            }

            options {
                timeout(time: 5, unit: 'MINUTES')
            }

            steps {
                script {
                    env.FAILED_STAGE = 'k6 Smoke'
                }

                sh '''
                    rm -rf "${K6_SMOKE_ARTIFACT_DIR}"
                    mkdir -p "${K6_SMOKE_ARTIFACT_DIR}"

                    k6_exit=0
                    docker run --rm \
                      --network host \
                      -v "$(pwd)/infra/k6/smoke.js:/scripts/smoke.js:ro" \
                      -v "$(pwd)/${K6_SMOKE_ARTIFACT_DIR}:/results" \
                      grafana/k6:latest run \
                      --out "json=/results/k6-results.json" \
                      --env BASE_URL="http://localhost:${BACKEND_HOST_PORT}" \
                      --env INCIDENT_ID="inc-precinct-first-001" \
                      --env POLICE_PHONE_ID="dev-alpha-phone-01" \
                      --env WEB_ACCOUNT_CODE="acct-cmd-alpha" \
                      --env APP_ACCOUNT_CODE="acct-team-alpha" \
                      --env FIXTURE_PASSWORD="fixture" \
                      --env SMOKE_DURATION="${K6_SMOKE_DURATION:-30s}" \
                      --env WEB_AUTH_P95_MS="${K6_WEB_AUTH_P95_MS:-2000}" \
                      --env APP_AUTH_P95_MS="${K6_APP_AUTH_P95_MS:-2000}" \
                      --env SSE_P95_MS="${K6_SSE_P95_MS:-15000}" \
                      --env HTTP_FAIL_RATE="${K6_HTTP_FAIL_RATE:-0.05}" \
                      /scripts/smoke.js \
                      > "${K6_SMOKE_ARTIFACT_DIR}/k6-output.txt" 2>&1 || k6_exit=$?

                    cat "${K6_SMOKE_ARTIFACT_DIR}/k6-output.txt"

                    if [ "${k6_exit}" -eq 0 ]; then
                        echo "STATUS: PASS" > "${K6_SMOKE_ARTIFACT_DIR}/k6-threshold-summary.txt"
                    else
                        echo "STATUS: FAIL" > "${K6_SMOKE_ARTIFACT_DIR}/k6-threshold-summary.txt"
                        echo "EXIT_CODE: ${k6_exit}" >> "${K6_SMOKE_ARTIFACT_DIR}/k6-threshold-summary.txt"
                    fi
                '''

                sh 'sh infra/ci/verify-k6-evidence.sh'
            }

            post {
                always {
                    archiveArtifacts(
                        allowEmptyArchive: true,
                        artifacts: 'ci-artifacts/k6-smoke/**',
                        fingerprint: true
                    )
                }
            }
        }
    }

    post {
        success {
            script {
                env.FAILED_STAGE = ''
                notifyMattermost('SUCCESS')
            }
        }

        failure {
            script {
                notifyMattermost('FAILURE')
            }
        }

        always {
            sh 'rm -f ${ENV_FILE} .github-dispatch-payload.json'
            sh 'rm -rf ci-artifacts'
        }
    }
}
