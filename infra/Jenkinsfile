        stage('Deploy Runtime') {
            steps {
                script {
                    env.FAILED_STAGE = 'Deploy Runtime'
                    env.MOCK112_INTERNAL_API_TOKEN = sh(
                        script: '''
                            set -eu
                            token_file=/home/ubuntu/infra/.mock112_internal_api_token
                            mkdir -p "$(dirname "${token_file}")"
                            if [ ! -s "${token_file}" ]; then
                              umask 077
                              if command -v openssl >/dev/null 2>&1; then
                                openssl rand -hex 32 > "${token_file}"
                              else
                                date +%s%N | sha256sum | cut -d" " -f1 > "${token_file}"
                              fi
                            fi
                            cat "${token_file}"
                        ''',
                        returnStdout: true
                    ).trim()
                    env.SURI_MAP_OBJECT_STORAGE_ACCESS_KEY = sh(
                        script: '''
                            set -eu
                            key_file=/home/ubuntu/infra/.object_storage_access_key
                            mkdir -p "$(dirname "${key_file}")"
                            if [ ! -s "${key_file}" ]; then
                              umask 077
                              echo "surimap$(date +%s%N | sha256sum | cut -c1-16)" > "${key_file}"
                            fi
                            cat "${key_file}"
                        ''',
                        returnStdout: true
                    ).trim()
                    env.SURI_MAP_OBJECT_STORAGE_SECRET_KEY = sh(
                        script: '''
                            set -eu
                            secret_file=/home/ubuntu/infra/.object_storage_secret_key
                            mkdir -p "$(dirname "${secret_file}")"
                            if [ ! -s "${secret_file}" ]; then
                              umask 077
                              if command -v openssl >/dev/null 2>&1; then
                                openssl rand -hex 32 > "${secret_file}"
                              else
                                date +%s%N | sha256sum | cut -d" " -f1 > "${secret_file}"
                              fi
                            fi
                            cat "${secret_file}"
                        ''',
                        returnStdout: true
                    ).trim()
                }

                writeFile file: env.ENV_FILE, text: """
FRONTEND_IMAGE=${env.FRONTEND_IMAGE}
BACKEND_IMAGE=${env.BACKEND_IMAGE}
MOCK_112_IMAGE=${env.MOCK_112_IMAGE}
KEYCLOAK_IMAGE=${env.KEYCLOAK_IMAGE}
