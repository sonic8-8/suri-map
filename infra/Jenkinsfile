          test -n "${client_uuid}"
          cat >"/tmp/suri-map-web-client.json" <<EOF
        {
          "redirectUris": [
            "${SURI_MAP_PUBLIC_ORIGIN}/*",
            "https://k14c106.p.ssafy.io/*",
