        ensure_mock112_client() {
          client_uuid=$(/opt/keycloak/bin/kcadm.sh get clients \
            -r suri-map \
                            -q clientId="suri-map-mock112" \
                            --fields id \
                            --format csv \
                            --noquotes | tail -n 1)
                          cat >"/tmp/suri-map-mock112-client.json" <<EOF
{
  "clientId": "suri-map-mock112",
  "name": "Suri-Map mock-112",
  "description": "mock-112 simulator public login client",
  "enabled": true,
  "protocol": "openid-connect",
  "publicClient": true,
  "standardFlowEnabled": true,
  "implicitFlowEnabled": false,
  "directAccessGrantsEnabled": false,
  "serviceAccountsEnabled": false,
          "frontchannelLogout": true,
          "redirectUris": [
            "${SURI_MAP_PUBLIC_ORIGIN}/mock-112/login/oauth2/code/keycloak",
            "https://k14c106.p.ssafy.io/mock-112/login/oauth2/code/keycloak",
            "http://localhost:18112/mock-112/login/oauth2/code/keycloak",
            "http://127.0.0.1:18112/mock-112/login/oauth2/code/keycloak"
          ],
          "webOrigins": [
            "${SURI_MAP_PUBLIC_ORIGIN}",
            "https://k14c106.p.ssafy.io",
            "http://localhost:18112",
            "http://127.0.0.1:18112"
  ]
}
EOF
                          if [ -n "${client_uuid}" ]; then
                            /opt/keycloak/bin/kcadm.sh update "clients/${client_uuid}" \
                              -r suri-map \
                              -f "/tmp/suri-map-mock112-client.json" >/dev/null
                          else
                            /opt/keycloak/bin/kcadm.sh create clients \
                              -r suri-map \
                              -f "/tmp/suri-map-mock112-client.json" >/dev/null
          fi
        }

        ensure_web_client() {
          client_uuid=$(/opt/keycloak/bin/kcadm.sh get clients \
            -r suri-map \
            -q clientId="suri-map-web" \
