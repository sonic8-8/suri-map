                              -f "/tmp/${username}-create.json" >/dev/null
                            user_id=$(/opt/keycloak/bin/kcadm.sh get users \
                              -r suri-map \
                              -q username="${username}" \
                              --fields id \
                              --format csv \
                              --noquotes | tail -n 1)
                            test -n "${user_id}"
                          fi
                          cat > "/tmp/${username}-profile.json" <<PROFILE_JSON
{
  "enabled": true,
  "email": "${email}",
  "emailVerified": true,
  "firstName": "${person_name}",
  "lastName": "",
  "attributes": {
    "accountId": ["${account_id}"],
    "accountType": ["${account_type}"],
    "organizationType": ["${organization_type}"],
    "accountCode": ["${username}"],
    "personName": ["${person_name}"],
    "displayName": ["${display_name}"],
    "organizationCode": ["${organization_code}"],
    "organizationName": ["${organization_name}"],
    "rankCode": ["${rank_code}"],
    "rankName": ["${rank_name}"],
    "dutyPositionCode": [],
    "dutyPositionName": []
  },
  "requiredActions": []
}
PROFILE_JSON
                          /opt/keycloak/bin/kcadm.sh update "users/${user_id}" \
                            -r suri-map \
                            -f "/tmp/${username}-profile.json" >/dev/null
                          /opt/keycloak/bin/kcadm.sh set-password \
                            -r suri-map \
                            --userid "${user_id}" \
                            --new-password 123456 >/dev/null
                        }

                        delete_keycloak_user_if_exists() {
                          username="$1"
                          user_id=$(/opt/keycloak/bin/kcadm.sh get users \
                            -r suri-map \
                            -q username="${username}" \
                            --fields id \
                            --format csv \
                            --noquotes | tail -n 1)
                          if [ -n "${user_id}" ]; then
                            /opt/keycloak/bin/kcadm.sh delete "users/${user_id}" -r suri-map >/dev/null
                          fi
                        }

                        for username in \
                          dohyun.kim \
                          minsu.park \
                          junho.lee \
                          seoyun.jeong \
                          jihun.choi \
                          hyunwoo.kang \
                          taeyoung.yoon \
                          minjae.oh \
                          taeho.mun \
                          minjae.seo \
                          yura.han \
                          jaehun.im \
                          seungwoo.baek \
                          arin.jo \
                          youngmin.cho \
                          nayoung.kim \
                          demo-suwang-patrol-02 \
                          demo-cheomdan-patrol-01 \
                          demo-missing-drone-team \
                          demo-missing-interview-team \
                          demo-support-field-01 \
                          demo-support-field-02 \
                          demo-support-traffic-car \
                          demo-support-reserve-team \
                          precinct1 \
                          precinct2 \
                          precinct3 \
                          precinct4 \
                          precinct5; do
                          delete_keycloak_user_if_exists "${username}"
                        done

                        for username in \
                          station1 \
                          station2 \
                          station3 \
                          missing1 \
                          missing2 \
                          support1 \
                          support2 \
                          support3 \
                          station4 \
                          station5 \
                          missing3 \
                          missing4 \
                          support4 \
                          support5 \
                          support6 \
                          support7 \
                          acct-unassigned-phone; do
                          ensure_demo_user_profile "${username}"
                        done
                        echo "keycloak_demo_user_profiles=ready"
                      '

                    if docker exec suri-map-frontend wget -qO- http://keycloak:8080/keycloak/realms/master/.well-known/openid-configuration | grep -q '"issuer"'; then
                      echo "keycloak_oidc=ready"
                    else
                      echo "keycloak_oidc=missing"
                      docker logs --tail=200 suri-map-keycloak || true
                      exit 1
                    fi

                    if docker exec suri-map-frontend wget -qO- http://keycloak:8080/keycloak/realms/suri-map/.well-known/openid-configuration | grep -q '"issuer"'; then
                      echo "keycloak_suri_map_realm=ready"
                    else
                      echo "keycloak_suri_map_realm=missing"
                      docker logs --tail=200 suri-map-keycloak || true
                      exit 1
                    fi

                    if docker exec suri-map-frontend wget -qO- http://127.0.0.1/keycloak/realms/suri-map/.well-known/openid-configuration | grep -q '"issuer"'; then
                      echo "keycloak_public_route=ready"
                    else
                      echo "keycloak_public_route=missing"
                      docker logs --tail=200 suri-map-keycloak || true
                      exit 1
                    fi

                    object_storage_ready=false
                    for i in $(seq 1 30); do
                      if docker exec suri-map-frontend wget -qO- http://object-storage:9000/minio/health/ready >/dev/null; then
                        echo "object_storage_health=ready"
                        object_storage_ready=true
                        break
                      fi
                      sleep 2
                    done

                    if [ "${object_storage_ready}" != "true" ]; then
                      echo "object_storage_health=timeout"
                      docker logs --tail=200 suri-map-object-storage || true
                      exit 1
                    fi

                    backend_ready=false
                    for i in $(seq 1 60); do
                      if docker exec suri-map-frontend wget -qO- http://backend:8080/api/health >/dev/null; then
                        echo "backend_health=ready"
                        backend_ready=true
                        break
                      fi
                      sleep 2
                    done

                    if [ "${backend_ready}" != "true" ]; then
                      echo "backend_health=timeout"
                      docker logs --tail=200 suri-map-backend || true
                      exit 1
                    fi

                    mock112_secret_hash=$(docker exec suri-map-mock-112 sh -c 'printf "%s" "${SURI_MAP_WEBHOOK_SECRET:-}" | sha256sum | cut -d" " -f1')
                    backend_secret_hash=$(docker exec suri-map-backend sh -c 'printf "%s" "${MOCK112_WEBHOOK_SECRET:-}" | sha256sum | cut -d" " -f1')
                    if [ "${mock112_secret_hash}" != "${backend_secret_hash}" ]; then
                      echo "mock112_webhook_secret=hash_mismatch"
                      exit 1
                    fi
                    echo "mock112_webhook_secret=matched"

                    if [ -f "${TILESERVER_DATA_DIR}/data/osm-local.mbtiles" ] \
                      && [ -f "${TILESERVER_DATA_DIR}/data/gwangju-building-labels.mbtiles" ]; then
                      tileserver_ready=false
                      for i in $(seq 1 30); do
                        if docker exec suri-map-tileserver-gl node -e "require('http').get('http://127.0.0.1:8080/styles/osm-local/style.json', r => process.exit(r.statusCode >= 200 && r.statusCode < 400 ? 0 : 1)).on('error', () => process.exit(1))"; then
                          echo "tileserver_health=ready"
                          tileserver_ready=true
                          break
                        fi
                        sleep 2
                      done

                      if [ "${tileserver_ready}" != "true" ]; then
                        echo "tileserver_health=timeout"
                        docker logs --tail=200 suri-map-tileserver-gl || true
                        exit 1
                      fi

                      if docker exec suri-map-tileserver-gl node -e "require('http').get('http://127.0.0.1:8080/fonts/Pretendard%20GOV/0-255.pbf', r => process.exit(r.statusCode >= 200 && r.statusCode < 400 ? 0 : 1)).on('error', () => process.exit(1))"; then
                        echo "tileserver_glyphs=ready"
                      else
                        echo "tileserver_glyphs=missing font_stack=Pretendard GOV range=0-255.pbf"
                        docker logs --tail=200 suri-map-tileserver-gl || true
                        exit 1
                      fi
                    else
                      echo "tileserver_health=skipped reason=missing_required_mbtiles"
                    fi
                '''
            }
        }

        stage('k6 Smoke') {
            when {
                expression {
                    return (env.K6_SMOKE_ENABLED ?: 'false').trim().equalsIgnoreCase('true')
                }
            }

            options {
                timeout(time: 5, unit: 'MINUTES')
            }

            steps {
                script {
                    env.FAILED_STAGE = 'k6 Smoke'
                }

                sh '''
                    rm -rf "${K6_SMOKE_ARTIFACT_DIR}"
                    mkdir -p "${K6_SMOKE_ARTIFACT_DIR}"

                    k6_exit=0
                    docker run --rm \
                      --network host \
                      -v "$(pwd)/infra/k6/smoke.js:/scripts/smoke.js:ro" \
                      -v "$(pwd)/${K6_SMOKE_ARTIFACT_DIR}:/results" \
                      grafana/k6:latest run \
                      --out "json=/results/k6-results.json" \
                      --env BASE_URL="http://localhost:${BACKEND_HOST_PORT}" \
                      --env INCIDENT_ID="aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaa0001" \
                      --env POLICE_PHONE_ID="00000000-0000-0000-0000-000000000205" \
                      --env WEB_ACCESS_TOKEN="${K6_WEB_ACCESS_TOKEN:-}" \
                      --env APP_ACCESS_TOKEN="${K6_APP_ACCESS_TOKEN:-}" \
                      --env SMOKE_DURATION="${K6_SMOKE_DURATION:-30s}" \
                      --env WEB_API_P95_MS="${K6_WEB_API_P95_MS:-2000}" \
                      --env APP_API_P95_MS="${K6_APP_API_P95_MS:-2000}" \
                      --env SSE_P95_MS="${K6_SSE_P95_MS:-15000}" \
                      --env HTTP_FAIL_RATE="${K6_HTTP_FAIL_RATE:-0.05}" \
                      /scripts/smoke.js \
                      > "${K6_SMOKE_ARTIFACT_DIR}/k6-output.txt" 2>&1 || k6_exit=$?

                    cat "${K6_SMOKE_ARTIFACT_DIR}/k6-output.txt"

                    if [ "${k6_exit}" -eq 0 ]; then
                        echo "STATUS: PASS" > "${K6_SMOKE_ARTIFACT_DIR}/k6-threshold-summary.txt"
                    else
                        echo "STATUS: FAIL" > "${K6_SMOKE_ARTIFACT_DIR}/k6-threshold-summary.txt"
                        echo "EXIT_CODE: ${k6_exit}" >> "${K6_SMOKE_ARTIFACT_DIR}/k6-threshold-summary.txt"
                    fi
                '''

                sh 'sh infra/ci/verify-k6-evidence.sh'
            }

            post {
                always {
                    archiveArtifacts(
                        allowEmptyArchive: true,
                        artifacts: 'ci-artifacts/k6-smoke/**',
                        fingerprint: true
                    )
                }
            }
        }
    }

    post {
        success {
            script {
                env.FAILED_STAGE = ''
                notifyMattermost('SUCCESS')
            }
        }

        failure {
            script {
                notifyMattermost('FAILURE')
            }
        }

        always {
            sh 'rm -f ${ENV_FILE} .github-dispatch-payload.json'
            sh 'rm -rf ci-artifacts'
        }
    }
}
